From 16496429bb3f861220c034428b2d9c27a156e6fd Mon Sep 17 00:00:00 2001
From: Joerg Roedel <joerg.roedel@amd.com>
Date: Wed, 2 Sep 2026 11:26:14 +0200
Subject: [PATCH 20/20] backends/igvm: Ignore IGVM command line directives

QEMU does not inject command lines to the guest via IGVM, so it is
safe to ignore this directive. This is needed for COCONUT-SVSM IGVM
files, which will start to contain this directive for other
Hypervisors.

Signed-off-by: Joerg Roedel <joerg.roedel@amd.com>
---
 backends/igvm.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/backends/igvm.c b/backends/igvm.c
index 74c5cb4d16..56ce64a84a 100644
--- a/backends/igvm.c
+++ b/backends/igvm.c
@@ -205,6 +205,11 @@ static int qigvm_handler(QIgvm *ctx, IgvmVariableHeaderType raw_type,
         return result;
     }
 
+    /* Safe to ignore: QEMU does not inject an IGVM command line */
+    if (type == IGVM_VHT_COMMAND_LINE) {
+        return 0;
+    }
+
     if (igvm_vht_optional(raw_type)) {
         warn_report("IGVM: Skipping unsupported optional header type 0x%"
                     PRIX32, type);
-- 
2.55.0

